<launch>
    <!-- PCR real mode: joy_ctrl publishes manual commands, PCR publishes PCR commands. -->
    <arg name="start_run_agent" default="true"/>
    <arg name="start_joy" default="true"/>
    <arg name="start_camera" default="true"/>
    <arg name="start_pcr" default="true"/>
    <arg name="publish_cmd" default="false"/>
    <arg name="start_mux" default="false"/>
    <arg name="show" default="false"/>

    <arg name="lowlevel_agent" default="base_line200.pt"/>
    <arg name="lowlevel_device" default="cpu"/>
    <arg name="pcr_device" default="cpu"/>
    <arg name="rate_hz" default="10"/>

    <arg name="pcr_ckpt" default="$(find interface)/scripts/pcr_real/checkpoints/moe_teacher_best_learnedw.pt"/>
    <arg name="avoid_ckpt" default="$(find interface)/scripts/pcr_real/checkpoints/avoid_best.pt"/>
    <arg name="lowlevel_ckpt" default="$(find interface)/scripts/pcr_real/checkpoints/low_level_best.pt"/>
    <arg name="yolo_model" default="$(find interface)/scripts/pcr_real/yolov8n.pt"/>

    <arg name="camera_height_m" default="0.23"/>
    <arg name="camera_pitch_down_deg" default="0"/>
    <arg name="map_size" default="32"/>
    <arg name="map_extent_m" default="3.0"/>
    <arg name="pcr_usr_command_topic" default="/usr/command_pcr"/>
    <arg name="manual_usr_command_topic" default="/usr/command_manual"/>
    <arg name="mux_output_topic" default="/usr/command"/>
    <arg name="mux_rate_hz" default="50"/>
    <arg name="mux_pcr_timeout_s" default="0.35"/>
    <arg name="mux_manual_timeout_s" default="0.2"/>

    <node if="$(arg start_run_agent)"
          pkg="interface"
          type="run_agent2.py"
          name="run_agent2"
          output="screen"
          args="--agent=$(arg lowlevel_agent)
                --device=$(arg lowlevel_device)
                --manual_command_topic $(arg manual_usr_command_topic)
                --pcr_command_topic $(arg pcr_usr_command_topic)"/>

    <group if="$(arg start_joy)">
        <node pkg="joy" type="joy_node" name="joy_node" output="screen"/>
        <node pkg="interface" type="joy_ctrl" name="joy_ctrl" output="screen">
            <param name="command_topic" value="$(arg manual_usr_command_topic)"/>
        </node>
    </group>

    <group if="$(arg start_camera)">
        <node unless="$(arg show)"
              pkg="interface"
              type="scripts/pcr_real/real_pcr_input_check.py"
              name="real_pcr_input"
              output="screen"
              args="--publish_ros
                    --yolo_model $(arg yolo_model)
                    --width 640
                    --height 480
                    --fps 30
                    --map_size $(arg map_size)
                    --map_extent_m $(arg map_extent_m)
                    --camera_height_m $(arg camera_height_m)
                    --camera_pitch_down_deg $(arg camera_pitch_down_deg)
                    --yolo_conf 0.35
                    --target_depth_mode roi
                    --ground_remove_height_m 0.04
                    --debug_map_px 260"/>
        <node if="$(arg show)"
              pkg="interface"
              type="scripts/pcr_real/real_pcr_input_check.py"
              name="real_pcr_input"
              output="screen"
              args="--publish_ros
                    --yolo_model $(arg yolo_model)
                    --width 640
                    --height 480
                    --fps 30
                    --map_size $(arg map_size)
                    --map_extent_m $(arg map_extent_m)
                    --camera_height_m $(arg camera_height_m)
                    --camera_pitch_down_deg $(arg camera_pitch_down_deg)
                    --yolo_conf 0.35
                    --target_depth_mode roi
                    --ground_remove_height_m 0.04
                    --debug_map_px 260
                    --show"/>
    </group>

    <group if="$(arg start_pcr)">
        <node unless="$(arg publish_cmd)"
              pkg="interface"
              type="scripts/pcr_real/pcr_realplay.py"
              name="pcr_realplay"
              output="screen"
              args="--pcr_ckpt $(arg pcr_ckpt)
                    --avoid_ckpt $(arg avoid_ckpt)
                    --lowlevel_ckpt $(arg lowlevel_ckpt)
                    --cmd_backend usr_command
                    --device $(arg pcr_device)
                    --rate_hz $(arg rate_hz)
                    --risk_memory
                    --max_cmd_x 0.06
                    --max_cmd_y 0.10
                    --max_cmd_yaw 0.20"/>
        <group if="$(arg publish_cmd)">
            <node pkg="interface"
                  type="scripts/pcr_real/pcr_realplay.py"
                  name="pcr_realplay"
                  output="screen"
                  args="--pcr_ckpt $(arg pcr_ckpt)
                        --avoid_ckpt $(arg avoid_ckpt)
                        --lowlevel_ckpt $(arg lowlevel_ckpt)
                        --cmd_backend usr_command
                        --usr_command_topic $(arg pcr_usr_command_topic)
                        --device $(arg pcr_device)
                        --rate_hz $(arg rate_hz)
                        --risk_memory
                        --max_cmd_x 0.06
                        --max_cmd_y 0.10
                        --max_cmd_yaw 0.20
                        --publish_cmd"/>
        </group>
    </group>
</launch>
