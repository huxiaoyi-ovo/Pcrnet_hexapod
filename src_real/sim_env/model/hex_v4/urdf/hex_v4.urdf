      <contact>
        <collision>l_lb_suck_collision</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="gazebo_ros_bumper_controller">
        <robotNamespace>/hex_v4</robotNamespace>
        <bumperTopicName>lb_contacts</bumperTopicName>
        <frameName>l_lb_suck</frameName>
      </plugin>
    </sensor>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo>
