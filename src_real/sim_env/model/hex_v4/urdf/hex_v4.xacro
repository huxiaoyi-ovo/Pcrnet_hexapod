<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hex_v4">
<xacro:property name="M_PI" value="3.1415926535897931"/>
<xacro:property name="joint_vec" value="5.864"/>
<xacro:macro name="leg" params="xyz rpy suffix rl">
  <link name="l_${suffix}_thigh">
    <inertial>
      <origin xyz="0.064022 0.00096119 0.000579" rpy="0 0 0" />
      <mass value="0.46413" />
      <inertia ixx="0.00019278"
        ixy="-5.2257E-08"
        ixz="-1.4788E-07"
        iyy="0.00018924"
        iyz="2.2903E-08"
        izz="0.00017553" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sim_env/model/hex_v4/meshes/l_${rl}_thigh.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01" />
      </geometry>
    </collision>
  </link>
  <joint
    name="j_${suffix}_thigh"
    type="revolute">
    <origin
      xyz="${xyz}"
      rpy="${rpy}" />
    <parent
      link="body" />
    <child
      link="l_${suffix}_thigh" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3"
      upper="3"
      effort="18"
      velocity="${joint_vec}"/>
    <dynamics damping="0.01" friction="0.5" />
  </joint>
  <link
    name="l_${suffix}_knee">
    <inertial>
      <origin
        xyz="0.066501 0.0033817 0.0021901"
        rpy="0 0 0" />
      <mass
        value="0.095847" />
      <inertia
        ixx="1.9167E-05"
        ixy="-1.9727E-07"
        ixz="-4.5905E-09"
        iyy="0.00017199"
        iyz="4.1768E-09"
        izz="0.00016755" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sim_env/model/hex_v4/meshes/l_${rl}_knee.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0.036 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint
    name="j_${suffix}_knee"
    type="revolute">
    <origin
      xyz="0.072 0 0"
      rpy="${M_PI/2} 0 0" />
    <parent
      link="l_${suffix}_thigh"/>
    <child
      link="l_${suffix}_knee"/>
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3"
      upper="3"
      effort="18"
      velocity="${joint_vec}" />
    <dynamics damping="0.01" friction="0.5" />
  </joint>
  <link
    name="l_${suffix}_ankle">
    <inertial>
      <origin
        xyz="0.023693 3.1616E-05 -0.00077324"
        rpy="0 0 0" />
      <mass
        value="0.48858" />
      <inertia
        ixx="0.00016687"
        ixy="3.1511E-07"
        ixz="-5.2998E-07"
        iyy="0.00048588"
        iyz="-5.087E-08"
        izz="0.00049222" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sim_env/model/hex_v4/meshes/l_${rl}_ankle.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint
    name="j_${suffix}_ankle"
    type="revolute">
    <origin
      xyz="0.13 0 0"
      rpy="0 0 0" />
    <parent
      link="l_${suffix}_knee" />
    <child
      link="l_${suffix}_ankle" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3"
      upper="3"
      effort="18"
      velocity="${joint_vec}" />
      <dynamics damping="0" friction="0.5" />
  </joint>
  <link
    name="l_${suffix}_foot">
    <inertial>
      <origin
        xyz="-0.00045734 -3.8425E-06 -0.0013561"
        rpy="0 0 0" />
      <mass
        value="0.028" />
      <inertia
        ixx="3.8123E-06"
        ixy="6.652E-15"
        ixz="7.2428E-09"
        iyy="3.163E-06"
        iyz="-2.2356E-13"
        izz="1.1087E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sim_env/model/hex_v4/meshes/l_${rl}_foot.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.64706 0.61961 0.58824 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <joint
    name="j_${suffix}_foot"
    type="revolute">
    <origin
      xyz="0.17 0 0"
      rpy="0 0 0" />
    <parent
      link="l_${suffix}_ankle" />
    <child
      link="l_${suffix}_foot" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="${-M_PI/2.0}"
      upper="${M_PI/2.0}"
      effort="1"
      velocity="${joint_vec/5.0}"/>
      <dynamics damping="0.0" friction="0.6" />
  </joint>

    <link name="l_${suffix}_ball1">
        <visual><geometry><sphere radius=".004"/></geometry></visual>
        <collision><geometry><sphere radius=".007"/></geometry></collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="1.96e-6" ixy="0.0" ixz="0.0" iyy="1.96e-6"  iyz="0.0" izz="1.96e-6"/>
        </inertial>
    </link>
    <joint name="j_${suffix}_ball1" type="revolute">
        <origin xyz="0.002 0 0" rpy="${-M_PI/2} 0 0"/>
        <parent link="l_${suffix}_foot"/>
        <child link="l_${suffix}_ball1"/>
        <axis xyz="0 0 1"/>
        <limit lower="${-M_PI/12.0}" upper="${M_PI/12.0}" effort="18" velocity="${joint_vec}"/>
        <dynamics damping="0" friction="0.6"/>
    </joint>

    <link name="l_${suffix}_ball2">
        <visual><geometry><sphere radius=".004"/></geometry></visual>
        <collision><geometry><sphere radius=".007"/></geometry></collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="1.96e-6" ixy="0.0" ixz="0.0" iyy="1.96e-6"  iyz="0.0" izz="1.96e-6"/>
        </inertial>
    </link>

    <joint name="j_${suffix}_ball2" type="revolute">
        <origin xyz="0 0 0" rpy="0 ${M_PI/2} 0"/>
        <parent link="l_${suffix}_ball1"/>
        <child link="l_${suffix}_ball2"/>
        <axis xyz="0 1 0"/>
        <limit lower="${-M_PI/12.0}" upper="${M_PI/12.0}" effort="18" velocity="${joint_vec}"/>
        <dynamics damping="0" friction="0.6"/>
    </joint>

  <link
    name="l_${suffix}_suck">
    <inertial>
      <origin
        xyz="-5.3073E-05 8.082E-07 -0.023883"
        rpy="0 0 0" />
      <mass
        value="0.064402" />
      <inertia
        ixx="2.5392E-05"
        ixy="-1.0544E-09"
        ixz="-6.2147E-09"
        iyy="2.5323E-05"
        iyz="9.4676E-11"
        izz="4.2031E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sim_env/model/hex_v4/meshes/l_lf_suck.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 -0.04"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.025" />
        <!-- <mesh filename="../meshes/l_lf_suck.STL" /> -->
      </geometry>
    </collision>
  </link>
  <joint
    name="j_${suffix}_suck"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="0 ${M_PI} 0" />
    <parent
      link="l_${suffix}_ball2"/>
    <child
      link="l_${suffix}_suck"/>
    <axis
      xyz="0 0 -1" />
    <limit
      lower="-3"
      upper="3"
      effort="10"
      velocity="${joint_vec}" />
  </joint>

    <transmission name="t_${suffix}_thigh">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="j_${suffix}_thigh">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>    
        </joint>
        <actuator name="m_${suffix}_thigh">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="t_${suffix}_knee">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="j_${suffix}_knee">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>    
        </joint>
        <actuator name="m_${suffix}_knee">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>    
    <transmission name="t_${suffix}_ankle">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="j_${suffix}_ankle">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>    
        </joint>
        <actuator name="m_${suffix}_ankle">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="t_${suffix}_foot">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="j_${suffix}_foot">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>    
        </joint>
        <actuator name="m_${suffix}_foot">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>    
    <transmission name="t_${suffix}_ball1">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="j_${suffix}_ball1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>    
        </joint>
        <actuator name="m_${suffix}_ball1">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <transmission name="t_${suffix}_ball2">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="j_${suffix}_ball2">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>    
        </joint>
        <actuator name="m_${suffix}_ball2">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
    <gazebo reference="l_${suffix}_suck">
      <mu1>10</mu1>
      <mu2>10</mu2>
      <kp>80000</kp>
      <kd>400</kd>
    </gazebo>

    <!-- <gazebo reference="j_${suffix}_knee">
        <provideFeedback>true</provideFeedback>
    </gazebo>
    <gazebo>
        <plugin filename="libgazebo_ros_ft_sensor.so"  name="ft_sensor">
            <updateRate>100</updateRate>
            <gaussianNoise>0.0</gaussianNoise>
            <topicName>${suffix}_knee_sensor</topicName>
            <jointName>j_${suffix}_knee</jointName>
        </plugin>
    </gazebo>
    <gazebo reference="j_${suffix}_ankle">
        <provideFeedback>true</provideFeedback>
    </gazebo>
    <gazebo>
        <plugin filename="libgazebo_ros_ft_sensor.so"  name="ft_sensor">
            <updateRate>100</updateRate>
            <gaussianNoise>0.0</gaussianNoise>
            <topicName>${suffix}_ankle_sensor</topicName>
            <jointName>j_${suffix}_ankle</jointName>
        </plugin>
    </gazebo> -->

    <gazebo reference="l_${suffix}_suck">
        <sensor name="{suffix}_contacts" type="contact">
            <update_rate>100.0</update_rate>
            <contact>
                <collision>l_${suffix}_suck_collision</collision>
            </contact>
            <plugin name="gazebo_ros_bumper_controller" filename="libgazebo_ros_bumper.so">
                <robotNamespace>/hex_v4</robotNamespace>
                <bumperTopicName>${suffix}_contacts</bumperTopicName>
                <frameName>l_${suffix}_suck</frameName>
            </plugin>
        </sensor>
        <selfCollide>false</selfCollide>
    </gazebo>
</xacro:macro>

<link name="dummy_link"/>  
<joint name="dummy_joint" type="fixed">  
  <parent link="dummy_link"/>  
  <child link="body"/>  
  <origin xyz="0 0 0" rpy="0 0 0"/>  
</joint>  
<link
    name="body">
    <inertial>
      <origin
        xyz="3.3531E-17 0.0058845 0.00075663"
        rpy="0 0 0" />
      <mass
        value="2.4764" />
      <inertia
        ixx="0.0096325"
        ixy="-8.9857E-08"
        ixz="-2.7461E-20"
        iyy="0.0029826"
        iyz="9.7948E-20"
        izz="0.011766" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sim_env/model/hex_v4/meshes/body.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.44 0.05"/>
      </geometry>
    </collision>
  </link>
<xacro:leg xyz="0.1 0.22 0" rpy="0 0 0" suffix="rf" rl="r"/>
<xacro:leg xyz="0.1 0 0" rpy="0 0 0" suffix="rm" rl="r"/>
<xacro:leg xyz="0.1 -0.22 0" rpy="0 0 0" suffix="rb" rl="r"/>
<xacro:leg xyz="-0.1 0.22 0" rpy="0 0 ${M_PI}" suffix="lf" rl="l"/>
<xacro:leg xyz="-0.1 0 0" rpy="0 0 ${M_PI}" suffix="lm" rl="l"/>
<xacro:leg xyz="-0.1 -0.22 0" rpy="0 0 ${M_PI}" suffix="lb" rl="l"/>
 <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="gazebo_ros_control">
      <robotNamespace>/hex_v4</robotNamespace>
    </plugin>
  </gazebo>
  <!--Run This Command to generate urdf files: rosrun xacro xacro hexapod_model121.xacro > hexapod_model121_gen.urdf -->
</robot>