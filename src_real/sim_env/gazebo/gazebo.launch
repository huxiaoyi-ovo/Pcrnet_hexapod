<launch>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <!-- <arg name="world_name" value="$(find blade_model)/empty_gazebo.world"/> -->
    </include>
  <!-- <node
    name="tf_footprint_base"
    pkg="tf"
    type="static_transform_publisher"
    args="0 0 0 0 0 0 base_link base_footprint 40" /> -->
  <param name="/robot_description" command="cat $(find sim_env)/model/hex_v4/urdf/hex_v4.urdf"/>
  <node
    name="spawn_model"
    pkg="gazebo_ros"
    type="spawn_model"
    args="-file $(find sim_env)/model/hex_v4/urdf/hex_v4.urdf -urdf -model hex_v4"
    output="screen" />
  <!-- <node
    name="fake_joint_calibration"
    pkg="rostopic"
    type="rostopic"
    args="pub /calibrated std_msgs/Bool true" /> -->
</launch>