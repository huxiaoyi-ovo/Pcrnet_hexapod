<?xml version="1.0"?>
<robot name="avoid_clutter_cylinder">
  <link name="cylinder">
    <inertial><origin xyz="0 0 0.25"/><mass value="100000"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
    <visual><origin xyz="0 0 0.25"/><geometry><cylinder radius="0.15" length="0.50"/></geometry><material name="gray"><color rgba="0.45 0.45 0.45 1"/></material></visual>
    <collision><origin xyz="0 0 0.25"/><geometry><cylinder radius="0.15" length="0.50"/></geometry></collision>
  </link>
</robot>
